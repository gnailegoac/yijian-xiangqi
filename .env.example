# 弈间 · 军师服务（大模型网关）配置样例
#
# 用法：把这个文件复制一份，改名为 .env.local，填上最前面两项，然后 npm start。
# .env.local 已被 .gitignore 忽略：千万不要提交它，也不要发给别人；请在网关后台给这把 key 设一个消费上限。
# 没有 .env.local 也能下棋：军师改由本地规则讲解，不联网。
#
# 行首带 # 的是可选项，括号里是默认值。要改哪一项，就去掉那一行行首的 #，在等号后面填值。

# OpenAI 兼容网关的地址，例如 https://gateway.example.com/v1
COACH_BASE_URL=
# 网关的 API key。没有它、又没开模拟模式时，军师模式是 off（no_key）
COACH_API_KEY=

# 每一种讲解都用的模型（默认 openai/openai/gpt-6-sol）
# COACH_MODEL=
# 开局和“对手走了一步”这两种一句话讲解用的模型（默认与 COACH_MODEL 相同）
# COACH_QUICK_MODEL=
# 推理强度（默认 low）；填 none 或留空 = 不向网关传这个参数
# COACH_REASONING_EFFORT=
# 一次回答最多生成多少 token（默认 1200）
# COACH_MAX_TOKENS=
# 终局小结最多生成多少 token（默认 1600）
# COACH_MAX_TOKENS_OVER=
# 等网关回答的最长时间，毫秒（默认 60000）
# COACH_UPSTREAM_TIMEOUT_MS=

# 模拟模式：填 1 时不访问网关，用固定的假回复（测试用，默认 0；npm run start:mock 等价）
# COACH_MOCK=
# 模拟模式下每一小段文字之间的间隔，毫秒（默认 15）
# COACH_MOCK_CHUNK_MS=

# 额外允许用来访问 /api 的主机名，逗号分隔、必须完全一致（默认空）。
# localhost、电脑名（含 电脑名.local）、本机和内网的 IP 地址本来就允许，不用填；
# 给电脑另起了名字（例如路由器里配的 chess.lan）、用那个名字打开时军师不说话，才需要填
# COACH_ALLOWED_HOSTS=
# 允许访问 /api 的其他网站来源，逗号分隔、必须完全一致（默认空）。
# 页面和 /api 同一个地址时不用填：局域网里的 iPad 就属于这种情况
# COACH_ALLOWED_ORIGINS=
# 填 1 时接受不带 Origin 头的 POST（curl、测试脚本用，默认 0）
# COACH_ALLOW_NO_ORIGIN=
# 填 1 时接受本机和内网地址以外的访问者（默认 0：只有家里局域网的设备能用军师）
# COACH_PUBLIC=

# 每个 IP 的限速：可突发的次数（默认 20）/ 每分钟补充的次数（默认 30）
# COACH_RATE_BURST=
# COACH_RATE_PER_MIN=
# 每天（UTC）的请求上限：每个 IP（默认 600）/ 全部加起来（默认 2000）
# COACH_IP_DAILY=
# COACH_GLOBAL_DAILY=
# 填 1 时从 x-forwarded-for 的第一段取访问者 IP（只有前面架了反向代理才需要，默认 0）
# COACH_TRUST_PROXY=

# 给军师的回复签名用的密钥，至少 32 个字符（默认由程序自己推导，一般不用填）
# COACH_SIGNING_KEY=
# 填 0 时不接受孩子自己打字提问，只保留按钮提问（默认 1）
# COACH_FREE_TEXT=
